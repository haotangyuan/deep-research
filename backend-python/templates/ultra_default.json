{
  "version": 1,
  "type": "general",
  "mode": "ultra_dynamic",
  "maxRounds": 5,
  "reviewer": {
    "count": 3,
    "lenses": ["evidence_sufficiency", "source_authority", "coverage_completeness"],
    "continueThreshold": 2
  },
  "report": {
